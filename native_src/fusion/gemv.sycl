#include <sycl/sycl.hpp>
#include <ATen/ATen.h>
#include <torch/library.h>
#include <c10/xpu/XPUStream.h>
#include <cstdint>

inline float decode_fp8(uint32_t raw) {
    uint32_t mag = raw & 127U;

    float normal = sycl::bit_cast<float>(
        (mag << 20) + 0x3c000000U
    );

    float value = mag < 8
        ? float(mag) * 0.001953125f
        : normal;

    if (mag == 127)
        value = sycl::bit_cast<float>(0x7fc00000U);

    return (raw & 128U) ? -value : value;
}

inline float decode_bf16(uint16_t raw) {
    return sycl::bit_cast<float>(
        uint32_t(raw) << 16
    );
}

inline uint16_t encode_bf16(float value) {
    uint32_t bits = sycl::bit_cast<uint32_t>(value);

    if ((bits & 0x7fffffffU) > 0x7f800000U)
        return uint16_t((bits >> 16) | 0x0040U);

    bits += 0x7fffU + ((bits >> 16) & 1U);

    return uint16_t(bits >> 16);
}

template<int WG>
class QwenFusionReferenceGemvKernel;

template<int WG>
void launch(
    sycl::queue &q,
    const uint16_t *x,
    const uint32_t *w,
    const float *scale,
    uint16_t *y,
    int n,
    int k
) {
    constexpr int SG = 32;
    constexpr int ROWS = WG / SG;

    size_t groups = (n + ROWS - 1) / ROWS;

    q.parallel_for<QwenFusionReferenceGemvKernel<WG>>(
        sycl::nd_range<1>(
            sycl::range<1>(groups * WG),
            sycl::range<1>(WG)
        ),
        [=](sycl::nd_item<1> item)
            [[sycl::reqd_sub_group_size(SG)]] {

            auto sg = item.get_sub_group();

            int row =
                item.get_group_linear_id() * ROWS
                + sg.get_group_linear_id();

            int lane = sg.get_local_linear_id();

            if (row >= n)
                return;

            const int words = k / 4;
            float sum = 0.0f;

            for (int i = lane; i < words; i += SG) {
                uint32_t packed =
                    w[size_t(row) * words + i];

                int col = i * 4;

                sum = sycl::fma(
                    decode_fp8(packed & 255U),
                    decode_bf16(x[col]), sum
                );

                sum = sycl::fma(
                    decode_fp8((packed >> 8) & 255U),
                    decode_bf16(x[col + 1]), sum
                );

                sum = sycl::fma(
                    decode_fp8((packed >> 16) & 255U),
                    decode_bf16(x[col + 2]), sum
                );

                sum = sycl::fma(
                    decode_fp8(packed >> 24),
                    decode_bf16(x[col + 3]), sum
                );
            }

            float result = sycl::reduce_over_group(
                sg, sum, sycl::plus<float>()
            );

            if (sg.leader())
                y[row] = encode_bf16(result * scale[0]);
        }
    );
}

void fp8_gemv(
    const at::Tensor &x,
    const at::Tensor &w,
    const at::Tensor &scale,
    at::Tensor &out,
    int64_t wg
) {
    TORCH_CHECK(x.is_xpu());
    TORCH_CHECK(w.device() == x.device());
    TORCH_CHECK(scale.device() == x.device());
    TORCH_CHECK(out.device() == x.device());

    TORCH_CHECK(x.scalar_type() == at::kBFloat16);
    TORCH_CHECK(w.scalar_type() == at::kByte);
    TORCH_CHECK(scale.scalar_type() == at::kFloat);
    TORCH_CHECK(out.scalar_type() == at::kBFloat16);

    TORCH_CHECK(x.is_contiguous());
    TORCH_CHECK(w.is_contiguous());
    TORCH_CHECK(scale.is_contiguous());
    TORCH_CHECK(out.is_contiguous());

    TORCH_CHECK(w.dim() == 2);

    int n = w.size(0);
    int k = w.size(1);

    TORCH_CHECK(n > 0 && k > 0 && k % 4 == 0);
    TORCH_CHECK(x.numel() == k);
    TORCH_CHECK(out.numel() == n);
    TORCH_CHECK(scale.numel() == 1);
    TORCH_CHECK(wg == 128 || wg == 256);
    TORCH_CHECK(
        reinterpret_cast<uintptr_t>(w.data_ptr()) % 4 == 0
    );

    auto &q = c10::xpu::getCurrentXPUStream(
        x.get_device()
    ).queue();

    auto xp = reinterpret_cast<const uint16_t *>(
        x.data_ptr()
    );

    auto wp = reinterpret_cast<const uint32_t *>(
        w.data_ptr()
    );

    auto sp = scale.data_ptr<float>();

    auto yp = reinterpret_cast<uint16_t *>(
        out.data_ptr()
    );

    if (wg == 128)
        launch<128>(q, xp, wp, sp, yp, n, k);
    else
        launch<256>(q, xp, wp, sp, yp, n, k);
}

TORCH_LIBRARY(qwen_sycl_fused, m) {
    m.def(
        "gemv(Tensor x, Tensor w, Tensor scale, "
        "Tensor(a!) out, int wg) -> ()"
    );
}

TORCH_LIBRARY_IMPL(qwen_sycl_fused, XPU, m) {
    m.impl("gemv", &fp8_gemv);
}

inline float accumulate4(
    uint32_t packed,
    float a, float b, float c, float d,
    float sum
) {
    sum = sycl::fma(
        decode_fp8(packed & 255U), a, sum
    );

    sum = sycl::fma(
        decode_fp8((packed >> 8) & 255U), b, sum
    );

    sum = sycl::fma(
        decode_fp8((packed >> 16) & 255U), c, sum
    );

    return sycl::fma(
        decode_fp8(packed >> 24), d, sum
    );
}

inline float round_bf16(float x) {
    return decode_bf16(encode_bf16(x));
}

template<int WG>
class QwenFusedMLPKernel;

template<int WG>
void launch_fused_mlp(
    sycl::queue &q,
    const uint16_t *x,
    const uint32_t *gate,
    const uint32_t *up,
    const float *gs,
    const float *us,
    uint16_t *y
) {
    constexpr int SG = 32;
    constexpr int N = 9728;
    constexpr int K = 2560;
    constexpr int WORDS = K / 4;
    constexpr int ROWS = WG / SG;

    q.parallel_for<QwenFusedMLPKernel<WG>>(
        sycl::nd_range<1>(
            sycl::range<1>((N / ROWS) * WG),
            sycl::range<1>(WG)
        ),
        [=](sycl::nd_item<1> item)
            [[sycl::reqd_sub_group_size(SG)]] {

            auto sg = item.get_sub_group();

            int row =
                item.get_group_linear_id() * ROWS
                + sg.get_group_linear_id();

            int lane = sg.get_local_linear_id();

            float g = 0.0f;
            float u = 0.0f;

            for (int i = lane; i < WORDS; i += SG) {
                int col = i * 4;

                float a = decode_bf16(x[col]);
                float b = decode_bf16(x[col + 1]);
                float c = decode_bf16(x[col + 2]);
                float d = decode_bf16(x[col + 3]);

                size_t offset = size_t(row) * WORDS + i;

                g = accumulate4(
                    gate[offset], a, b, c, d, g
                );

                u = accumulate4(
                    up[offset], a, b, c, d, u
                );
            }

            g = sycl::reduce_over_group(
                sg, g, sycl::plus<float>()
            );

            u = sycl::reduce_over_group(
                sg, u, sycl::plus<float>()
            );

            if (sg.leader()) {
                g = round_bf16(g * gs[0]);
                u = round_bf16(u * us[0]);

                float activated = round_bf16(
                    g / (1.0f + sycl::exp(-g))
                );

                y[row] = encode_bf16(activated * u);
            }
        }
    );
}

template<int WG>
class QwenFusedQKVKernel;

template<int WG>
void launch_fused_qkv(
    sycl::queue &queue,
    const uint16_t *x,
    const uint32_t *qw,
    const uint32_t *kw,
    const uint32_t *vw,
    const float *qs,
    const float *ks,
    const float *vs,
    uint16_t *qo,
    uint16_t *ko,
    uint16_t *vo
) {
    constexpr int SG = 32;
    constexpr int N = 6144;
    constexpr int K = 2560;
    constexpr int WORDS = K / 4;
    constexpr int ROWS = WG / SG;

    queue.parallel_for<QwenFusedQKVKernel<WG>>(
        sycl::nd_range<1>(
            sycl::range<1>((N / ROWS) * WG),
            sycl::range<1>(WG)
        ),
        [=](sycl::nd_item<1> item)
            [[sycl::reqd_sub_group_size(SG)]] {

            auto sg = item.get_sub_group();

            int row =
                item.get_group_linear_id() * ROWS
                + sg.get_group_linear_id();

            int lane = sg.get_local_linear_id();

            const uint32_t *w;
            const float *scale;
            uint16_t *out;

            if (row < 4096) {
                w = qw;
                scale = qs;
                out = qo;
            } else if (row < 5120) {
                row -= 4096;
                w = kw;
                scale = ks;
                out = ko;
            } else {
                row -= 5120;
                w = vw;
                scale = vs;
                out = vo;
            }

            float sum = 0.0f;

            for (int i = lane; i < WORDS; i += SG) {
                int col = i * 4;

                sum = accumulate4(
                    w[size_t(row) * WORDS + i],
                    decode_bf16(x[col]),
                    decode_bf16(x[col + 1]),
                    decode_bf16(x[col + 2]),
                    decode_bf16(x[col + 3]),
                    sum
                );
            }

            sum = sycl::reduce_over_group(
                sg, sum, sycl::plus<float>()
            );

            if (sg.leader())
                out[row] = encode_bf16(sum * scale[0]);
        }
    );
}

void check_projection(
    const at::Tensor &x,
    const at::Tensor &w,
    const at::Tensor &s,
    const at::Tensor &out,
    int64_t n
) {
    TORCH_CHECK(x.is_xpu());
    TORCH_CHECK(x.scalar_type() == at::kBFloat16);
    TORCH_CHECK(x.is_contiguous());
    TORCH_CHECK(x.numel() == 2560);

    TORCH_CHECK(w.device() == x.device());
    TORCH_CHECK(s.device() == x.device());
    TORCH_CHECK(out.device() == x.device());

    TORCH_CHECK(w.scalar_type() == at::kByte);
    TORCH_CHECK(s.scalar_type() == at::kFloat);
    TORCH_CHECK(out.scalar_type() == at::kBFloat16);

    TORCH_CHECK(w.is_contiguous());
    TORCH_CHECK(s.is_contiguous());
    TORCH_CHECK(out.is_contiguous());

    TORCH_CHECK(
        w.dim() == 2 &&
        w.size(0) == n &&
        w.size(1) == 2560
    );

    TORCH_CHECK(s.numel() == 1);
    TORCH_CHECK(out.numel() == n);

    TORCH_CHECK(
        reinterpret_cast<uintptr_t>(
            w.data_ptr()
        ) % 4 == 0
    );
}

void fused_mlp(
    const at::Tensor &x,
    const at::Tensor &gate,
    const at::Tensor &up,
    const at::Tensor &gs,
    const at::Tensor &us,
    at::Tensor &out,
    int64_t wg
) {
    check_projection(x, gate, gs, out, 9728);
    check_projection(x, up, us, out, 9728);

    TORCH_CHECK(wg == 128 || wg == 256);

    auto &q = c10::xpu::getCurrentXPUStream(
        x.get_device()
    ).queue();

    auto xp = reinterpret_cast<const uint16_t *>(
        x.data_ptr()
    );

    auto gp = reinterpret_cast<const uint32_t *>(
        gate.data_ptr()
    );

    auto uptr = reinterpret_cast<const uint32_t *>(
        up.data_ptr()
    );

    auto yp = reinterpret_cast<uint16_t *>(
        out.data_ptr()
    );

    if (wg == 128)
        launch_fused_mlp<128>(
            q, xp, gp, uptr,
            gs.data_ptr<float>(),
            us.data_ptr<float>(), yp
        );
    else
        launch_fused_mlp<256>(
            q, xp, gp, uptr,
            gs.data_ptr<float>(),
            us.data_ptr<float>(), yp
        );
}

void fused_qkv(
    const at::Tensor &x,
    const at::Tensor &qw,
    const at::Tensor &kw,
    const at::Tensor &vw,
    const at::Tensor &qs,
    const at::Tensor &ks,
    const at::Tensor &vs,
    at::Tensor &qo,
    at::Tensor &ko,
    at::Tensor &vo,
    int64_t wg
) {
    check_projection(x, qw, qs, qo, 4096);
    check_projection(x, kw, ks, ko, 1024);
    check_projection(x, vw, vs, vo, 1024);

    TORCH_CHECK(wg == 128 || wg == 256);

    auto &q = c10::xpu::getCurrentXPUStream(
        x.get_device()
    ).queue();

    auto xp = reinterpret_cast<const uint16_t *>(
        x.data_ptr()
    );

    auto qp = reinterpret_cast<const uint32_t *>(
        qw.data_ptr()
    );

    auto kp = reinterpret_cast<const uint32_t *>(
        kw.data_ptr()
    );

    auto vp = reinterpret_cast<const uint32_t *>(
        vw.data_ptr()
    );

    auto qop = reinterpret_cast<uint16_t *>(qo.data_ptr());
    auto kop = reinterpret_cast<uint16_t *>(ko.data_ptr());
    auto vop = reinterpret_cast<uint16_t *>(vo.data_ptr());

    if (wg == 128)
        launch_fused_qkv<128>(
            q, xp, qp, kp, vp,
            qs.data_ptr<float>(),
            ks.data_ptr<float>(),
            vs.data_ptr<float>(),
            qop, kop, vop
        );
    else
        launch_fused_qkv<256>(
            q, xp, qp, kp, vp,
            qs.data_ptr<float>(),
            ks.data_ptr<float>(),
            vs.data_ptr<float>(),
            qop, kop, vop
        );
}

TORCH_LIBRARY_FRAGMENT(qwen_sycl_fused, m) {
    m.def(
        "mlp(Tensor x, Tensor gate, Tensor up, "
        "Tensor gs, Tensor us, Tensor(a!) out, int wg) -> ()"
    );

    m.def(
        "qkv(Tensor x, Tensor qw, Tensor kw, Tensor vw, "
        "Tensor qs, Tensor ks, Tensor vs, "
        "Tensor(a!) qo, Tensor(b!) ko, Tensor(c!) vo, "
        "int wg) -> ()"
    );
}

TORCH_LIBRARY_IMPL(qwen_sycl_fused, XPU, m) {
    m.impl("mlp", &fused_mlp);
    m.impl("qkv", &fused_qkv);
}
